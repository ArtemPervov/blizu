# Local development works without .env; these settings are for Docker production.
APP_ORIGIN=https://blizu.example.com
PROXY_NETWORK=proxy
ADMIN_EMAIL=admin@example.com
# Required: a unique password, at least 12 characters.
ADMIN_PASSWORD=
# Optional: initial operator account, separate from the arbiter above.
# Set BOTH values to create a new account; leave both empty to provision via CLI.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
ENABLE_DEMO=false
ENABLE_DELIVERY=false
DELIVERY_STALE_HOURS=72
# Optional Ollama assistant. In Docker, attach the API to the Ollama network first.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_MS=45000
BLIZU_IMAGE_PREFIX=blizu
BLIZU_VERSION=latest
