# Local development works without .env; these settings are for Docker production.
APP_ORIGIN=https://blizu.example.com
PROXY_NETWORK=proxy
ADMIN_EMAIL=admin@example.com
# Required: a unique password, at least 12 characters.
ADMIN_PASSWORD=
ENABLE_DEMO=false
DELIVERY_STALE_HOURS=72
BLIZU_IMAGE_PREFIX=blizu
BLIZU_VERSION=latest
